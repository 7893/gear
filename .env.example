# Configuration names only. Keep real deployment values out of Git.
# Copy to .env for local use and restrict that file to mode 600.
# Deployment tooling maps selected names to runtime bindings; business app setup is pending.

# Linked public repository identifier. Actual owner/repository stays in local configuration.
GITHUB_REPOSITORY=

# SSH hosts and origin addresses. Keep private keys in the existing SSH credential store.
DEV_SSH_HOST=
DEPLOY_SSH_HOST=
DEPLOY_HOST=
DEPLOY_PORT=
DEPLOY_USER=
DEPLOY_WEB_ROOT=
# Dedicated CI account and private file references; credentials remain outside Git.
CI_DEPLOY_USER=
DEPLOY_SSH_KEY_FILE=
DEPLOY_KNOWN_HOSTS_FILE=
ORIGIN_IPV4=
ORIGIN_IPV6=

# Current website and API origins. Real values are private.
PUBLIC_APP_URL=
PUBLIC_API_URL=

# Existing Google Cloud DNS zone. Account credentials remain outside the repository.
GCP_PROJECT_ID=
GCP_DNS_ZONE=
FRONTEND_DNS_NAME=
# Independent origin hostname; configured separately from the public CDN entry.
ORIGIN_DNS_NAME=

# Current CloudFront deployment and dedicated CI role.
AWS_PROFILE=
AWS_DEPLOY_ROLE_ARN=
AWS_ACM_REGION=
AWS_CLOUDFRONT_DISTRIBUTION_ID=
CDN_DOMAIN=
AWS_CLOUDFRONT_ORIGIN_HOST=
AWS_CLOUDFRONT_EXISTING_CERTIFICATE_ARN=
# Dedicated imported Google certificate used by this application.
AWS_CLOUDFRONT_CERTIFICATE_ARN=
AWS_CLOUDFRONT_CACHE_POLICY_ID=
AWS_WAF_WEB_ACL_ARN=

# Server-only values. Never expose these through frontend environment variables or logs.
AWS_CLOUDFRONT_ORIGIN_HEADER_NAME=
AWS_CLOUDFRONT_ORIGIN_HEADER_VALUE=
GEAR_ORIGIN_HEADER_VALUE=

# Backend Cloudflare custom domain. Keep account and zone identifiers private.
BACKEND_DNS_NAME=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_GATEWAY_NAME=
# Owner-selected existing local development token; private project file reference.
CLOUDFLARE_API_TOKEN_FILE=

# Shared existing Supabase project; application tables and memberships are isolated.
SUPABASE_URL=
SUPABASE_PROJECT_REF=
SUPABASE_REGION=
GEAR_DB_SCHEMA=
GEAR_STORAGE_BUCKET=
GEAR_FUNCTION_PREFIX=
GEAR_ACCOUNTS_ENABLED=
GEAR_RECOVERY_ENABLED=
GEAR_INVENTORY_ENABLED=
GEAR_FLOWS_ENABLED=
GEAR_EVIDENCE_ENABLED=
GEAR_EVIDENCE_APP_URL=
# Private manifest for the authorized demo batch; never expose it to the browser.
GEAR_DEMO_MANIFEST_FILE=
GEAR_ADMIN_EMAIL=
GEAR_ADMIN_DISPLAY_NAME=
GEAR_AUTH_WEBHOOK_SECRET=
GEAR_AUTH_WEBHOOK_SECRET_FILE=
GEAR_AUTH_PUBLIC_URL=
GEAR_AUTH_APP_URL=
GEAR_NOTIFICATION_FUNCTION_URL=
GEAR_NOTIFICATION_TOKEN=
GEAR_NOTIFICATION_TOKEN_FILE=
GEAR_GMAIL_CLIENT_ID=
GEAR_GMAIL_CLIENT_SECRET=
GEAR_GMAIL_REFRESH_TOKEN=
GEAR_MAIL_FROM=
SUPABASE_PUBLISHABLE_KEY=
# Server-only key; never bundle it into the frontend.
SUPABASE_SECRET_KEY=

# Existing private Gmail files: reference paths instead of copying OAuth secrets or tokens.
GMAIL_OAUTH_CLIENT_FILE=
GMAIL_TOKEN_FILE=
MAIL_FROM=
