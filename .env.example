# Configuration names only. Keep real deployment values out of Git.
# Copy to .env for local use and restrict that file to mode 600.
# These names describe planned deployment configuration; no application consumes them yet.

# Linked public repository identifier. Actual owner/repository stays in local configuration.
GITHUB_REPOSITORY=

# SSH hosts and origin addresses. Keep private keys in the existing SSH credential store.
DEV_SSH_HOST=
DEPLOY_SSH_HOST=
DEPLOY_HOST=
DEPLOY_PORT=
DEPLOY_USER=
DEPLOY_WEB_ROOT=
ORIGIN_IPV4=
ORIGIN_IPV6=

# Website address selected for future deployment; API address remains unset until confirmed.
PUBLIC_APP_URL=
PUBLIC_API_URL=

# Existing Google Cloud DNS zone. Account credentials remain outside the repository.
GCP_PROJECT_ID=
GCP_DNS_ZONE=
FRONTEND_DNS_NAME=

# Existing CloudFront candidate: currently disabled, not an already deployed application.
AWS_PROFILE=
AWS_ACM_REGION=
AWS_CLOUDFRONT_DISTRIBUTION_ID=
CDN_DOMAIN=
AWS_CLOUDFRONT_ORIGIN_HOST=
AWS_CLOUDFRONT_EXISTING_CERTIFICATE_ARN=
AWS_WAF_WEB_ACL_ARN=

# Server-only values. Never expose these through frontend environment variables or logs.
AWS_CLOUDFRONT_ORIGIN_HEADER_NAME=
AWS_CLOUDFRONT_ORIGIN_HEADER_VALUE=

# Shared existing Supabase project; application isolation is not implemented yet.
SUPABASE_URL=
SUPABASE_PROJECT_REF=
SUPABASE_REGION=
GEAR_DB_SCHEMA=
GEAR_STORAGE_BUCKET=
GEAR_FUNCTION_PREFIX=
SUPABASE_PUBLISHABLE_KEY=
# Server-only key; never bundle it into the frontend.
SUPABASE_SECRET_KEY=

# Existing private Gmail files: reference paths instead of copying OAuth secrets or tokens.
GMAIL_OAUTH_CLIENT_FILE=
GMAIL_TOKEN_FILE=
MAIL_FROM=
