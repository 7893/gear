{
  "name": "gear-api-gateway",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "lint": "eslint src tests cloudflare.config.ts vite.config.ts",
    "format:check": "prettier --check src tests cloudflare.config.ts vite.config.ts tsconfig.json package.json eslint.config.mjs",
    "types": "cf workers types",
    "typecheck": "pnpm run types && tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "build": "cf build",
    "check": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.1",
    "@types/node": "24.19.2",
    "cf": "1.0.0-beta.17",
    "eslint": "10.8.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4"
  }
}
