# Render only the named deployment variables into a private configuration file.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name ${ORIGIN_DNS_NAME};
    ssl_certificate /etc/nginx/gear/fullchain.pem;
    ssl_certificate_key /etc/nginx/gear/private.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    root ${DEPLOY_WEB_ROOT};
    index index.html;
    access_log off;
    if ($http_x_gear_origin_token != "${AWS_CLOUDFRONT_ORIGIN_HEADER_VALUE}") { return 403; }
    add_header Cache-Control "no-cache" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex" always;
    location = /healthz {
        default_type application/json;
        return 200 '{"status":"ready","service":"gear-origin","application":"not-deployed"}';
    }
    location = /robots.txt {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=3600";
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex" always;
    }
    # Future builds must use content hashes in asset filenames.
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex" always;
    }
    # Only public bootstrap files use short edge caching. Browsers revalidate;
    # releases invalidate both paths. Auth, RPCs and files never use this origin.
    location = /index.html {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=0, s-maxage=300, must-revalidate";
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex" always;
    }
    location = /runtime-config.json {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=0, s-maxage=60, must-revalidate";
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex" always;
    }
    location / { try_files $uri $uri/ /index.html; }
}
